# Fonzo Tech — environment variables
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values. The ".env" file is for LOCAL
# development. On Vercel, the Neon integration (Storage tab) injects
# DATABASE_URL automatically — nothing to set by hand.
# -----------------------------------------------------------------------------

# Neon Postgres connection string.
# On Vercel: added automatically by the Neon integration.
# Locally: copy it from the Neon dashboard (or Vercel -> Storage -> your
# database -> ".env.local" tab).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: comma-separated emails allowed to sign in to the team portal.
# If left unset, defaults to the three addresses below.
# TEAM_EMAILS=ak514596@gmail.com,team@fonzotech.co.uk,admin@fonzotech.co.uk

# Optional: local development port (defaults to 5000).
# PORT=5000
